{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "objectWrap": "preserve",
  "arrowParens": "always",
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "experimentalOperatorPosition": "end",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next",
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "storybook-static",
    "package-lock.json",
    "public",
    "docs",
    "design",
    "server/db/generated",
    "prisma/migrations"
  ]
}
