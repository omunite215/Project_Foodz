// Foodz data model.
// Money is stored in integer cents. Times are UTC. Geography columns are managed with raw SQL
// (PostGIS), so they appear here as Unsupported and are written through the data access layer.

generator client {
  provider        = "prisma-client"
  output          = "../server/db/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm, unaccent]
}

// ------------------------------------------------------------------ auth (Better Auth)

model User {
  id                   String    @id @db.Uuid
  name                 String
  email                String    @unique
  emailVerified        Boolean   @default(false) @map("email_verified")
  image                String?
  phone                String?
  role                 String    @default("customer")
  banned               Boolean?  @default(false)
  banReason            String?   @map("ban_reason")
  banExpires           DateTime? @map("ban_expires")
  twoFactorEnabled     Boolean?  @default(false) @map("two_factor_enabled")
  termsAcceptedVersion Int?      @map("terms_accepted_version")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  /// A shared, read-only demo login. Set by the seed only (trigger users_guard_seed_flags).
  isDemo               Boolean   @default(false) @map("is_demo")
  /// Sample data from the seed (local and demo deployments). Shown unmasked to demo logins like
  /// demo accounts. Only the table owner (migrations, seed) can set or change it; the trigger
  /// users_guard_seed_flags refuses every other role.
  isSample             Boolean   @default(false) @map("is_sample")
  /// Confirm-email links issued before this instant are refused (set when the email is changed).
  emailLinksValidAfter DateTime? @map("email_links_valid_after")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  accounts        Account[]
  twoFactors      TwoFactor[]
  addresses       Address[]
  partner         DeliveryPartner?
  favorites       Favorite[]
  orders          Order[]
  redemptions     CouponRedemption[]
  reviews         Review[]
  partnerRatings  PartnerRating[]
  reportsFiled    PartnerReport[]    @relation("ReportReporter")
  reportsResolved PartnerReport[]    @relation("ReportResolver")
  refundRequests  RefundRequest[]    @relation("RefundRequester")
  refundsDecided  RefundRequest[]    @relation("RefundDecider")
  notifications   Notification[]
  blogPosts       BlogPost[]
  uploads         Upload[]
  contentVersions ContentVersion[]
  soldOutDishes   MenuItem[]         @relation("MenuItemSoldOutBy")

  @@map("users")
}

model Session {
  id             String    @id @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  token          String    @unique
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  impersonatedBy String?   @map("impersonated_by")
  /// The last step-up code this session passed (F5 A7.10); server-only, never sent to the browser.
  stepUpAt       DateTime? @map("step_up_at")
  userId         String    @map("user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

// ------------------------------------------------------------------ customers

enum AddressKind {
  HOME
  WORK
  OTHER
}

// One default per user and at most 10 per user are kept by the address service (under a
// per-user lock). `location` is maintained by a trigger from lat/lng.
model Address {
  id        String                                 @id @default(uuid(7)) @db.Uuid
  userId    String                                 @map("user_id") @db.Uuid
  kind      AddressKind                            @default(OTHER)
  label     String
  line1     String
  line2     String?
  city      String
  notes     String?
  lat       Float
  lng       Float
  location  Unsupported("geography(Point, 4326)")?
  isDefault Boolean                                @default(false) @map("is_default")
  createdAt DateTime                               @default(now()) @map("created_at")
  user      User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([location], type: Gist)
  @@map("addresses")
}

model Favorite {
  userId     String   @map("user_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([userId, menuItemId])
  @@map("favorites")
}

// ------------------------------------------------------------------ menu

enum Cuisine {
  KOREAN
  THAI
  VIETNAMESE
}

model MenuItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  title       String
  description String
  priceCents  Int       @map("price_cents")
  cuisine     Cuisine
  images      String[]
  flavors     String[]
  prepMinutes Int       @default(20) @map("prep_minutes")
  isSpecial   Boolean   @default(false) @map("is_special")
  isAvailable Boolean   @default(true) @map("is_available")
  /// "86 it" (F5): when and by whom the dish was marked sold out; null while it is on the menu.
  soldOutAt   DateTime? @map("sold_out_at")
  soldOutById String?   @map("sold_out_by") @db.Uuid
  ratingAvg   Float     @default(0) @map("rating_avg")
  ratingCount Int       @default(0) @map("rating_count")
  soldCount   Int       @default(0) @map("sold_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Search document (title, cuisine name, description), a column the database generates (F3
  /// migration f3_menu_search). The default below is that generation expression exactly as
  /// Postgres prints it, so `prisma migrate dev` sees no difference; Prisma never writes it.
  /// The trigram index on the accent-free title is an expression index Prisma can't describe.
  searchVector Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('foodz_search'::regconfig, title), 'A'::\"char\") || setweight(to_tsvector('foodz_search'::regconfig,\nCASE cuisine\n    WHEN 'KOREAN'::\"Cuisine\" THEN 'Korean'::text\n    WHEN 'THAI'::\"Cuisine\" THEN 'Thai'::text\n    WHEN 'VIETNAMESE'::\"Cuisine\" THEN 'Vietnamese'::text\n    ELSE ''::text\nEND), 'B'::\"char\")) || setweight(to_tsvector('foodz_search'::regconfig, description), 'C'::\"char\"))")) @map("search_vector")

  soldOutBy  User?       @relation("MenuItemSoldOutBy", fields: [soldOutById], references: [id], onDelete: SetNull)
  favorites  Favorite[]
  orderItems OrderItem[]
  reviews    Review[]
  campaigns  Campaign[]

  @@index([cuisine, isAvailable])
  @@index([searchVector], type: Gin)
  @@map("menu_items")
}

// ------------------------------------------------------------------ orders

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

/// A card dispute (chargeback) opened by the customer's bank (F4 B3).
enum DisputeStatus {
  NONE
  OPEN
  WON
  LOST
}

// Row-level security (F4): customers read their own orders; operations staff read every order,
// except that demo staff read only demo and sample people's (others through order_directory,
// masked). Only the platform (checkout, webhooks, jobs) and non-demo operations staff write.
// `number` comes from the order_number_seq sequence (1001, 1002, ...); the seed's sample keeps S1001.
model Order {
  id                    String                                 @id @default(uuid(7)) @db.Uuid
  number                String                                 @unique @default(dbgenerated("(nextval('order_number_seq'::regclass))::text"))
  userId                String                                 @map("user_id") @db.Uuid
  status                OrderStatus                            @default(PENDING_PAYMENT)
  paymentMethod         PaymentMethod                          @map("payment_method")
  paymentStatus         PaymentStatus                          @default(UNPAID) @map("payment_status")
  contactName           String                                 @map("contact_name")
  contactPhone          String                                 @map("contact_phone")
  addressText           String                                 @map("address_text")
  /// The address as it was when ordering (S2.10): editing or deleting it later changes nothing.
  addressLabel          String?                                @map("address_label")
  addressLine1          String?                                @map("address_line1")
  /// Apartment, floor.
  addressLine2          String?                                @map("address_line2")
  /// City and ZIP, e.g. "Boston, MA 02109".
  addressCity           String?                                @map("address_city")
  /// F8: the neighborhood from the address geocode, for "Priya · Downtown" (A46).
  addressArea           String?                                @map("address_area")
  courierInstructions   String?                                @map("courier_instructions")
  addressLat            Float                                  @map("address_lat")
  addressLng            Float                                  @map("address_lng")
  location              Unsupported("geography(Point, 4326)")?
  distanceKm            Float                                  @map("distance_km")
  /// The kitchen note for the whole order.
  note                  String?
  subtotalCents         Int                                    @map("subtotal_cents")
  /// Off the food (the promo); tax is worked out after it.
  discountCents         Int                                    @default(0) @map("discount_cents")
  /// The real delivery fee, kept even with free delivery so courier pay is unchanged (F3 B4).
  deliveryFeeCents      Int                                    @map("delivery_fee_cents")
  /// A free-delivery promo, stored apart from the fee.
  deliveryDiscountCents Int                                    @default(0) @map("delivery_discount_cents")
  taxCents              Int                                    @map("tax_cents")
  taxRateBps            Int?                                   @map("tax_rate_bps")
  tipCents              Int                                    @default(0) @map("tip_cents")
  /// none | 10 | 15 | 20 | amount: what the customer picked (kept for "remember my tip").
  tipChoice             String                                 @default("none") @map("tip_choice")
  totalCents            Int                                    @map("total_cents")
  refundedCents         Int                                    @default(0) @map("refunded_cents")
  couponId              String?                                @map("coupon_id") @db.Uuid
  /// The code as applied, kept if the coupon is later deleted.
  promoCode             String?                                @map("promo_code")
  stripePaymentIntentId String?                                @unique @map("stripe_payment_intent_id")
  stripePaymentMethodId String?                                @map("stripe_payment_method_id")
  /// For receipts: "Visa •••• 4242". Card details never reach Foodz beyond these two.
  cardBrand             String?                                @map("card_brand")
  cardLast4             String?                                @map("card_last4")
  disputeStatus         DisputeStatus                          @default(NONE) @map("dispute_status")
  disputeOpenedAt       DateTime?                              @map("dispute_opened_at")
  disputeClosedAt       DateTime?                              @map("dispute_closed_at")
  /// The checkout press that made this order (S7.2); one live order per key and customer.
  attemptKey            String?                                @map("attempt_key")
  /// Hash of the dishes and the address, for the two-minute duplicate check (S7.5).
  cartFingerprint       String?                                @map("cart_fingerprint")
  /// Arrival window in minutes after placing (S3.1): "35–45 min".
  arrivalFromMinutes    Int?                                   @map("arrival_from_minutes")
  arrivalToMinutes      Int?                                   @map("arrival_to_minutes")
  /// Why Foodz itself refunded the card: customer-cancel | late-payment | mismatch | staff-cancel.
  autoRefundReason      String?                                @map("auto_refund_reason")
  expiresAt             DateTime?                              @map("expires_at")
  placedAt              DateTime?                              @map("placed_at")
  /// The kitchen's steps (F5); cleared again when a step is undone or moved back.
  acceptedAt            DateTime?                              @map("accepted_at")
  preparingAt           DateTime?                              @map("preparing_at")
  readyAt               DateTime?                              @map("ready_at")
  pickedUpAt            DateTime?                              @map("picked_up_at")
  deliveredAt           DateTime?                              @map("delivered_at")
  cancelledAt           DateTime?                              @map("cancelled_at")
  /// customer | payment-expired | account-deleted | staff | kitchen-refused
  cancelReason          String?                                @map("cancel_reason")
  /// Why staff cancelled (one of the board's seven reasons); never shown to the customer.
  cancelCode            String?                                @map("cancel_code")
  /// The lines a "dish is unavailable" cancellation ticked.
  cancelLineIds         String[]                               @default([]) @map("cancel_line_ids") @db.Uuid
  /// The longest prep of the dishes as ordered, for ready-by (set by a trigger on order_items).
  prepMinutes           Int?                                   @map("prep_minutes")
  /// Customer notices already sent (accepted, ready, picked-up, delivered, cancelled): each once.
  notifiedSteps         String[]                               @default([]) @map("notified_steps")
  version               Int                                    @default(0)
  /// The version at which the status last changed (trigger orders_track_status).
  statusChangedVersion  Int                                    @default(0) @map("status_changed_version")
  createdAt             DateTime                               @default(now()) @map("created_at")
  updatedAt             DateTime                               @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon         Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  events         OrderEvent[]
  delivery       Delivery?
  redemption     CouponRedemption?
  reviews        Review[]
  partnerRating  PartnerRating?
  reports        PartnerReport[]
  refundRequests RefundRequest[]

  @@unique([userId, attemptKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, cartFingerprint])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([location], type: Gist)
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  title          String
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  flavors        String[]
  note           String?
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  type       String
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus? @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  data       Json?
  createdAt  DateTime     @default(now()) @map("created_at")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ------------------------------------------------------------------ delivery partners

enum PartnerStatus {
  APPLIED
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  BICYCLE
  SCOOTER
  MOTORBIKE
  CAR
}

enum IdDocumentType {
  DRIVER_LICENSE
  STATE_ID
  PASSPORT
}

/// One row per account (F6). Row-level security and the delivery_partners_guard_write trigger
/// decide who may change what; staff read it through partner_directory.
model DeliveryPartner {
  id                     String                                 @id @default(uuid(7)) @db.Uuid
  userId                 String                                 @unique @map("user_id") @db.Uuid
  status                 PartnerStatus                          @default(APPLIED)
  vehicleType            VehicleType                            @map("vehicle_type")
  vehiclePlate           String?                                @map("vehicle_plate")
  /// AES-256-GCM, bound to `delivery_partners.license_number:<id>`; never decrypted by the app.
  licenseNumberEnc       String?                                @map("license_number_enc")
  photoUploadId          String?                                @map("photo_upload_id") @db.Uuid
  idDocumentUploadId     String?                                @map("id_document_upload_id") @db.Uuid
  idDocumentType         IdDocumentType?                        @map("id_document_type")
  idDocumentExpiresOn    DateTime?                              @map("id_document_expires_on") @db.Date
  idNumberLast4          String?                                @map("id_number_last4")
  /// HMAC-SHA256 with ID_NUMBER_HASH_KEY, for the "same ID number" flag only.
  idNumberHash           String?                                @map("id_number_hash")
  isOnline               Boolean                                @default(false) @map("is_online")
  lastLocation           Unsupported("geography(Point, 4326)")? @map("last_location")
  lastSeenAt             DateTime?                              @map("last_seen_at")
  ratingAvg              Float                                  @default(0) @map("rating_avg")
  ratingCount            Int                                    @default(0) @map("rating_count")
  reviewNote             String?                                @map("review_note")
  approvedAt             DateTime?                              @map("approved_at")
  submittedAt            DateTime?                              @map("submitted_at")
  editedAt               DateTime?                              @map("edited_at")
  fixedAt                DateTime?                              @map("fixed_at")
  decidedAt              DateTime?                              @map("decided_at")
  decidedBy              String?                                @map("decided_by") @db.Uuid
  decisionReason         String?                                @map("decision_reason")
  changesRequestedAt     DateTime?                              @map("changes_requested_at")
  changesRequestedNote   String?                                @map("changes_requested_note")
  changesRequestedBy     String?                                @map("changes_requested_by") @db.Uuid
  reapplyAfter           DateTime?                              @map("reapply_after") @db.Date
  filesDeletedAt         DateTime?                              @map("files_deleted_at")
  suspendedAt            DateTime?                              @map("suspended_at")
  suspensionReason       String?                                @map("suspension_reason")
  onlineSince            DateTime?                              @map("online_since")
  onlineSessionId        String?                                @map("online_session_id") @db.Uuid
  offlineReason          String?                                @map("offline_reason")
  offlineAt              DateTime?                              @map("offline_at")
  partnerTermsVersion    Int?                                   @map("partner_terms_version")
  partnerTermsAcceptedAt DateTime?                              @map("partner_terms_accepted_at")
  adultConfirmedAt       DateTime?                              @map("adult_confirmed_at")
  welcomedAt             DateTime?                              @map("welcomed_at")
  /// F8: the demo courier the platform drives (U14); never set by anyone else.
  isBot                  Boolean                                @default(false) @map("is_bot")
  /// F7: the dispatch line (W3) and its counters (P25, W7.4), kept by the database.
  waitingSince           DateTime?                              @map("waiting_since")
  lastPointAt            DateTime?                              @map("last_point_at")
  /// When `last_location` last changed; the same fix again keeps `last_point_at` fresh for 2 minutes after it.
  lastMovedAt            DateTime?                              @map("last_moved_at")
  missedInRow            Int                                    @default(0) @map("missed_in_row")
  unseenInRow            Int                                    @default(0) @map("unseen_in_row")
  /// P31: the last order taken from this partner by someone else, for a notice he missed.
  releasedKind           String?                                @map("released_kind")
  releasedOrderNumber    String?                                @map("released_order_number")
  releasedAt             DateTime?                              @map("released_at")
  version                Int                                    @default(0)
  plateKey               String?                                @default(dbgenerated("upper(regexp_replace(vehicle_plate, '[[:space:]-]'::text, ''::text, 'g'::text))")) @map("plate_key")
  createdAt              DateTime                               @default(now()) @map("created_at")
  updatedAt              DateTime                               @updatedAt @map("updated_at")
  user                   User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUpload            Upload?                                @relation("PartnerPhoto", fields: [photoUploadId], references: [id])
  idDocumentUpload       Upload?                                @relation("PartnerDocument", fields: [idDocumentUploadId], references: [id])
  deliveries             Delivery[]
  offers                 DeliveryOffer[]
  earnings               PartnerEarning[]
  ratings                PartnerRating[]
  reports                PartnerReport[]
  history                PartnerApplicationEvent[]

  @@index([status, isOnline])
  @@index([lastLocation], type: Gist)
  @@index([status, submittedAt])
  @@map("delivery_partners")
}

/// The application's history (F6 A31.1): append-only for the app.
model PartnerApplicationEvent {
  id            String          @id @db.Uuid
  partnerId     String          @map("partner_id") @db.Uuid
  type          String
  actorKind     String          @map("actor_kind")
  actorId       String?         @map("actor_id") @db.Uuid
  actorName     String?         @map("actor_name")
  actorRole     String?         @map("actor_role")
  at            DateTime        @default(now())
  applicantText String?         @map("applicant_text")
  staffNote     String?         @map("staff_note")
  changedParts  String[]        @default([]) @map("changed_parts")
  versionAfter  Int?            @map("version_after")
  partner       DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, at])
  @@map("partner_application_events")
}

enum DeliveryStatus {
  SEARCHING
  ASSIGNED
  AT_RESTAURANT
  PICKED_UP
  DELIVERED
  CANCELLED
}

model Delivery {
  id                      String             @id @default(uuid(7)) @db.Uuid
  orderId                 String             @unique @map("order_id") @db.Uuid
  partnerId               String?            @map("partner_id") @db.Uuid
  status                  DeliveryStatus     @default(SEARCHING)
  routeGeoJson            Json?              @map("route_geojson")
  routeDistanceM          Int?               @map("route_distance_m")
  routeDurationSec        Int?               @map("route_duration_sec")
  etaAt                   DateTime?          @map("eta_at")
  partnerFeeCents         Int                @default(0) @map("partner_fee_cents")
  assignedAt              DateTime?          @map("assigned_at")
  pickedUpAt              DateTime?          @map("picked_up_at")
  deliveredAt             DateTime?          @map("delivered_at")
  /// F7 (B2): the search for a courier. Partial unique indexes and the guard trigger live in
  /// the migration.
  readyAt                 DateTime?          @map("ready_at")
  readyEventId            String?            @map("ready_event_id") @db.Uuid
  searchStartedAt         DateTime?          @map("search_started_at")
  searchRestartedAt       DateTime?          @map("search_restarted_at")
  escalatedAt             DateTime?          @map("escalated_at")
  searchStoppedAt         DateTime?          @map("search_stopped_at")
  searchStopReason        String?            @map("search_stop_reason")
  pool                    String             @default("REAL")
  tipCents                Int                @default(0) @map("tip_cents")
  excludedPartnerIds      String[]           @default([]) @map("excluded_partner_ids") @db.Uuid
  partnerWaitingSince     DateTime?          @map("partner_waiting_since")
  readyToAssignedSeconds  Int?               @map("ready_to_assigned_seconds")
  courierChanged          Boolean            @default(false) @map("courier_changed")
  /// F8: the courier's own steps, the code's lock and the door (contract §5).
  atRestaurantAt          DateTime?          @map("at_restaurant_at")
  endedAt                 DateTime?          @map("ended_at")
  otpWrongTries           Int                @default(0) @map("otp_wrong_tries")
  otpLockedAt             DateTime?          @map("otp_locked_at")
  almostNotifiedAt        DateTime?          @map("almost_notified_at")
  noAnswerSince           DateTime?          @map("no_answer_since")
  noAnswerReportedAt      DateTime?          @map("no_answer_reported_at")
  noAnswerWaitRestartedAt DateTime?          @map("no_answer_wait_restarted_at")
  problemKind             String?            @map("problem_kind")
  problemAt               DateTime?          @map("problem_at")
  etaEstimated            Boolean            @default(false) @map("eta_estimated")
  routeUpdatedAt          DateTime?          @map("route_updated_at")
  handoverHow             String?            @map("handover_how")
  code                    DeliveryCode?
  version                 Int                @default(0)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  order                   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner                 DeliveryPartner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  offers                  DeliveryOffer[]
  locations               DeliveryLocation[]
  earnings                PartnerEarning[]

  @@index([partnerId, status])
  @@map("deliveries")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model DeliveryOffer {
  id          String          @id @default(uuid(7)) @db.Uuid
  deliveryId  String          @map("delivery_id") @db.Uuid
  partnerId   String          @map("partner_id") @db.Uuid
  status      OfferStatus     @default(PENDING)
  expiresAt   DateTime        @map("expires_at")
  respondedAt DateTime?       @map("responded_at")
  /// F7: auto (the run) or staff (`offeredBy`); pay frozen when made (U12).
  kind        String          @default("auto")
  offeredBy   String?         @map("offered_by") @db.Uuid
  round       Int             @default(1)
  reachKm     Int?            @map("reach_km")
  pickupM     Int             @default(0) @map("pickup_m")
  payCents    Int             @default(0) @map("pay_cents")
  tipCents    Int             @default(0) @map("tip_cents")
  seenAt      DateTime?       @map("seen_at")
  pressedAt   DateTime?       @map("pressed_at")
  endedReason String?         @map("ended_reason")
  createdAt   DateTime        @default(now()) @map("created_at")
  delivery    Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([deliveryId, createdAt])
  @@map("delivery_offers")
}

model DeliveryLocation {
  id         BigInt                                 @id @default(autoincrement())
  deliveryId String                                 @map("delivery_id") @db.Uuid
  lat        Float
  lng        Float
  location   Unsupported("geography(Point, 4326)")?
  heading    Float?
  speedKmh   Float?                                 @map("speed_kmh")
  recordedAt DateTime                               @default(now()) @map("recorded_at")
  delivery   Delivery                               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
  @@index([location], type: Gist)
  @@map("delivery_locations")
}

enum EarningType {
  DELIVERY_FEE
  TIP
  BONUS
  ADJUSTMENT
}

model PartnerEarning {
  id          String          @id @default(uuid(7)) @db.Uuid
  partnerId   String          @map("partner_id") @db.Uuid
  deliveryId  String?         @map("delivery_id") @db.Uuid
  type        EarningType
  amountCents Int             @map("amount_cents")
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  delivery    Delivery?       @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@map("partner_earnings")
}

// ------------------------------------------------------------------ promotions

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

// Row-level security (F3): a personal or store-credit code (owner_user_id set) is visible only to
// its owner and to non-demo support and admin; public codes are visible to everyone.
model Coupon {
  id               String     @id @default(uuid(7)) @db.Uuid
  code             String     @unique
  description      String?
  type             CouponType
  value            Int
  minSubtotalCents Int        @default(0) @map("min_subtotal_cents")
  maxDiscountCents Int?       @map("max_discount_cents")
  usageLimit       Int?       @map("usage_limit")
  perUserLimit     Int?       @map("per_user_limit")
  usedCount        Int        @default(0) @map("used_count")
  cuisines         Cuisine[]
  ownerUserId      String?    @map("owner_user_id") @db.Uuid
  isStoreCredit    Boolean    @default(false) @map("is_store_credit")
  isActive         Boolean    @default(true) @map("is_active")
  startsAt         DateTime   @default(now()) @map("starts_at")
  endsAt           DateTime?  @map("ends_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  orders         Order[]
  redemptions    CouponRedemption[]
  campaigns      Campaign[]
  refundRequests RefundRequest[]

  @@map("coupons")
}

enum RedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

model CouponRedemption {
  id            String           @id @default(uuid(7)) @db.Uuid
  couponId      String           @map("coupon_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  orderId       String           @unique @map("order_id") @db.Uuid
  status        RedemptionStatus @default(RESERVED)
  discountCents Int              @map("discount_cents")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  coupon        Coupon           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId, status])
  @@map("coupon_redemptions")
}

enum CampaignPlacement {
  HOME_CAROUSEL
  ANNOUNCEMENT_BAR
  MENU_TOP
}

model Campaign {
  id        String            @id @default(uuid(7)) @db.Uuid
  title     String
  subtitle  String?
  imageKey  String?           @map("image_key")
  ctaLabel  String?           @map("cta_label")
  ctaHref   String?           @map("cta_href")
  placement CampaignPlacement
  couponId  String?           @map("coupon_id") @db.Uuid
  priority  Int               @default(0)
  isActive  Boolean           @default(true) @map("is_active")
  startsAt  DateTime          @map("starts_at")
  endsAt    DateTime          @map("ends_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  coupon    Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  menuItems MenuItem[]

  @@index([placement, isActive, startsAt, endsAt])
  @@map("campaigns")
}

// ------------------------------------------------------------------ feedback

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  menuItemId String       @map("menu_item_id") @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  rating     Int
  comment    String?
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId, orderId])
  @@index([menuItemId, status, createdAt])
  @@map("reviews")
}

model PartnerRating {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  partnerId String          @map("partner_id") @db.Uuid
  orderId   String          @unique @map("order_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("partner_ratings")
}

// ------------------------------------------------------------------ trust & safety

enum ReportCategory {
  LATE
  RUDE
  UNSAFE_DRIVING
  FOOD_TAMPERED
  EXTRA_MONEY
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

enum ReportAction {
  NONE
  WARNED
  SUSPENDED
  BANNED
}

model PartnerReport {
  id           String          @id @default(uuid(7)) @db.Uuid
  reporterId   String          @map("reporter_id") @db.Uuid
  partnerId    String          @map("partner_id") @db.Uuid
  orderId      String          @map("order_id") @db.Uuid
  category     ReportCategory
  description  String
  photoKeys    String[]        @map("photo_keys")
  status       ReportStatus    @default(OPEN)
  adminAction  ReportAction    @default(NONE) @map("admin_action")
  adminNote    String?         @map("admin_note")
  resolvedById String?         @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?       @map("resolved_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  reporter     User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?           @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  partner      DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([reporterId, orderId])
  @@index([partnerId, status, createdAt])
  @@map("partner_reports")
}

enum RefundReason {
  MISSING_ITEM
  WRONG_ITEM
  DAMAGED
  COLD
  LATE
  OTHER
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PARTIAL
  REJECTED
  REFUNDED
}

model RefundRequest {
  id             String       @id @default(uuid(7)) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  reason         RefundReason
  description    String?
  items          Json?
  requestedCents Int          @map("requested_cents")
  approvedCents  Int?         @map("approved_cents")
  photoKeys      String[]     @map("photo_keys")
  status         RefundStatus @default(REQUESTED)
  decisionReason String?      @map("decision_reason")
  decidedById    String?      @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?    @map("decided_at")
  stripeRefundId String?      @unique @map("stripe_refund_id")
  creditCouponId String?      @map("credit_coupon_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User         @relation("RefundRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy      User?        @relation("RefundDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  creditCoupon   Coupon?      @relation(fields: [creditCouponId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
  @@map("refund_requests")
}

// ------------------------------------------------------------------ content

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id          String     @id @default(uuid(7)) @db.Uuid
  slug        String     @unique
  title       String
  excerpt     String
  coverKey    String?    @map("cover_key")
  content     Json
  contentHtml String     @map("content_html")
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  views       Int        @default(0)
  authorId    String     @map("author_id") @db.Uuid
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags        Tag[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

model Tag {
  id    String     @id @default(uuid(7)) @db.Uuid
  name  String     @unique
  slug  String     @unique
  color Int        @default(1)
  posts BlogPost[]

  @@map("tags")
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  email     String
  phone     String?
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

model SiteSettings {
  id                   Int                                    @id @default(1)
  storeName            String                                 @map("store_name")
  addressText          String                                 @map("address_text")
  lat                  Float
  lng                  Float
  location             Unsupported("geography(Point, 4326)")?
  timezone             String                                 @default("America/New_York")
  deliveryRadiusKm     Float                                  @default(8) @map("delivery_radius_km")
  baseDeliveryFeeCents Int                                    @default(199) @map("base_delivery_fee_cents")
  perKmFeeCents        Int                                    @default(50) @map("per_km_fee_cents")
  taxRateBps           Int                                    @default(700) @map("tax_rate_bps")
  openingHours         Json                                   @map("opening_hours")
  contactEmail         String                                 @map("contact_email")
  contactPhone         String                                 @map("contact_phone")
  socialLinks          Json                                   @default("{}") @map("social_links")
  footerLinks          Json                                   @default("[]") @map("footer_links")
  seo                  Json                                   @default("{}")
  updatedById          String?                                @map("updated_by_id") @db.Uuid
  updatedAt            DateTime                               @updatedAt @map("updated_at")

  @@index([location], type: Gist)
  @@map("site_settings")
}

model ContentPage {
  id                 String           @id @default(uuid(7)) @db.Uuid
  slug               String           @unique
  title              String
  draft              Json?
  publishedVersionId String?          @unique @map("published_version_id") @db.Uuid
  updatedAt          DateTime         @updatedAt @map("updated_at")
  publishedVersion   ContentVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           ContentVersion[] @relation("PageVersions")

  @@map("content_pages")
}

model ContentVersion {
  id            String       @id @default(uuid(7)) @db.Uuid
  pageId        String       @map("page_id") @db.Uuid
  version       Int
  title         String
  content       Json
  contentHtml   String       @map("content_html")
  publishedById String       @map("published_by_id") @db.Uuid
  publishedAt   DateTime     @default(now()) @map("published_at")
  page          ContentPage  @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedBy   User         @relation(fields: [publishedById], references: [id], onDelete: Restrict)
  publishedOf   ContentPage? @relation("PublishedVersion")

  @@unique([pageId, version])
  @@map("content_versions")
}

// ------------------------------------------------------------------ files

enum UploadBucket {
  PUBLIC
  PRIVATE
}

enum UploadStatus {
  PENDING
  READY
  REJECTED
}

enum UploadPurpose {
  MENU_IMAGE
  BANNER
  BLOG_COVER
  AVATAR
  PARTNER_PHOTO
  PARTNER_DOCUMENT
  REFUND_PHOTO
  REPORT_PHOTO
}

model Upload {
  id               String            @id @default(uuid(7)) @db.Uuid
  key              String            @unique
  bucket           UploadBucket
  purpose          UploadPurpose
  status           UploadStatus      @default(PENDING)
  ownerId          String            @map("owner_id") @db.Uuid
  contentType      String            @map("content_type")
  sizeBytes        Int               @map("size_bytes")
  width            Int?
  height           Int?
  rejectedReason   String?           @map("rejected_reason")
  /// TOO_LARGE, BAD_TYPE, UNREADABLE or NOT_RECEIVED (F6 design 4.4).
  rejectCode       String?           @map("reject_code")
  processedAt      DateTime?         @map("processed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  partnerPhotos    DeliveryPartner[] @relation("PartnerPhoto")
  partnerDocuments DeliveryPartner[] @relation("PartnerDocument")

  @@index([ownerId, purpose])
  @@map("uploads")
}

// ------------------------------------------------------------------ system

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
}

/// One row, made by the F4 migration: a random tag for this database. Every PaymentIntent carries
/// it, so the webhook ignores events from other machines that share the Stripe test account (B6).
model AppInstance {
  id        Int      @id @default(1)
  tag       String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("app_instance")
}

/// F8 (U4): the delivery code, encrypted for the customer's page and hashed for the check. Read
/// only by the order's customer and the platform; written by the definer functions.
model DeliveryCode {
  deliveryId    String    @id @map("delivery_id") @db.Uuid
  codeEnc       String    @map("code_enc")
  codeHash      String    @map("code_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Gate S8: the last wrong try, so a re-send of it within seconds isn't counted again.
  lastWrongHash String?   @map("last_wrong_hash")
  lastWrongAt   DateTime? @map("last_wrong_at")
  delivery      Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_codes")
}

/// F8 (L10): the demo admin's pretend deliveries, one at a time.
model DemoRun {
  id          String   @id @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  startedAt   DateTime @default(now()) @map("started_at")
  endsAt      DateTime @map("ends_at")
  status      String   @default("running")
  requestedBy String?  @map("requested_by") @db.Uuid

  @@index([startedAt])
  @@map("demo_runs")
}
