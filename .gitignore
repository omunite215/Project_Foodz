# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Amazon RDS public CA bundle (public certificates, see docker/rds/README)
!docker/rds/global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (secrets) — only the example is committed
.env*
!.env.example

# local-only working material (design source, notes, specs)
/docs/
/design/

# test & tool output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/storybook-static/
.semgrep/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client
/server/db/generated/
