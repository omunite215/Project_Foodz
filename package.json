{
  "name": "foodz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3456",
    "build": "next build",
    "start": "next start --port 3456",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "design:extract": "node scripts/figma/extract.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "storage:setup": "node scripts/storage-setup.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:board": "tsx prisma/seed-board.ts",
    "seed:partners": "tsx prisma/seed-partners.ts",
    "seed:earnings": "tsx prisma/seed-earnings.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "verify": "node scripts/verify.mjs",
    "e2e": "playwright test",
    "semgrep": "node scripts/semgrep.mjs",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --quiet"
  },
  "dependencies": {
