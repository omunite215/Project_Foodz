# Copy to .env and fill in. `npm run setup:env` generates local development values.

NEXT_PUBLIC_SITE_URL=http://localhost:3456

# --- Database (Postgres + PostGIS) ---------------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_MIGRATOR_PASSWORD=change-me
DB_APP_PASSWORD=change-me
DB_READONLY_PASSWORD=change-me
# The app connects as the least-privileged role; migrations use the migrator role.
DATABASE_URL=postgresql://foodz_app:change-me@127.0.0.1:5433/foodz
DATABASE_MIGRATOR_URL=postgresql://foodz_migrator:change-me@127.0.0.1:5433/foodz
DATABASE_READONLY_URL=postgresql://foodz_readonly:change-me@127.0.0.1:5433/foodz

# --- Redis (rate limits, live courier positions) -------------------------
REDIS_PASSWORD=change-me
# rediss:// (TLS) for ElastiCache.
REDIS_URL=redis://:change-me@127.0.0.1:6380

# --- Object storage (S3 API: RustFS locally; on AWS leave S3_ENDPOINT and both keys unset and
# the task role is used) --------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_PUBLIC_BUCKET=foodz-public
S3_PRIVATE_BUCKET=foodz-private
S3_PUBLIC_URL=http://127.0.0.1:9000/foodz-public

# --- Email ---------------------------------------------------------------
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Foodz <no-reply@foodz.local>"

# --- Realtime (Pusher protocol: Soketi locally, Pusher in production) ----
PUSHER_APP_ID=foodz
PUSHER_SECRET=change-me
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_USE_TLS=false
NEXT_PUBLIC_PUSHER_KEY=change-me
NEXT_PUBLIC_PUSHER_HOST=127.0.0.1
NEXT_PUBLIC_PUSHER_PORT=6001
NEXT_PUBLIC_PUSHER_USE_TLS=false
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# --- Background jobs (Inngest) -------------------------------------------
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Auth ----------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3456
# Where rate limits get the client address (server/client-ip.ts). On Vercel the platform supplies
# it and these are ignored. Anywhere else, put a reverse proxy in front of the app that
# overwrites X-Forwarded-For with the address it sees (nginx:
# `proxy_set_header X-Forwarded-For $remote_addr;`, Caddy: `header_up X-Forwarded-For
# {remote_host}`) and set TRUSTED_PROXY_HOPS=1, one more for each further proxy that appends (2 behind
# CloudFront and an ALB, as in infra/).
# With 0 and no Vercel, client headers are never trusted: every visitor shares one limit, and
# the server warns at start-up.
TRUSTED_PROXY_HOPS=0
# Tests only: take the address from the client's own X-Forwarded-For, so each browser test is
# its own network. playwright.config.ts and CI set it; never set it on a real deployment
# (refused on Vercel production).
CLIENT_IP_FROM_HEADER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Bot protection (these are Cloudflare's public test keys, which always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Payments (Stripe test mode) -----------------------------------------
STRIPE_SECRET_KEY=
# The whsec_… that `docker compose --profile payments up -d` prints (stripe listen).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Minutes a card order waits for its payment (15 when empty). Lower it locally to watch an expiry.
ORDER_PAYMENT_TTL_MINUTES=

# --- Field encryption (base64, 32 bytes) for partner ID numbers ----------
FIELD_ENCRYPTION_KEY=

# --- Seed data (prisma/seed.ts) -----------------------------------------
# The real admin account. Its two-factor secret is printed once, the first time the seed runs.
SEED_ADMIN_EMAIL=admin@foodz.example
SEED_ADMIN_PASSWORD=change-me
# Shared password for the public demo accounts (customer, partner, read-only admin).
DEMO_PASSWORD=change-me
# Adds sample customers (unconfirmed, suspended, a second customer with an address). They are
# ordinary, writable accounts, so they are for local and CI databases only: the seed refuses any
# other database, and they never go on the public demo. Their password is random on every seed
# run and printed in the seed output (the browser tests read it through E2E_SEED_OUTPUT).
SEED_SAMPLE_ACCOUNTS=true

# --- Monitoring ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
